# ---------------------------------------------------------------------------
# Quiz Builder — Backend configuration
#
# Copy to `.env` and adjust per environment. NEVER commit the real `.env`.
# Environments: development (local), staging (staging), production (production).
#   APP_ENV=local          # development
#   APP_ENV=staging        # staging / testing preview
#   APP_ENV=production     # production (APP_DEBUG must be false)
# ---------------------------------------------------------------------------

APP_NAME="Quiz Builder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public base URL of the backend (used for generated links).
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
# production: LOG_CHANNEL=daily  (one file per day, auto-pruned to 14 files)
# stack = single + stderr; LOG_LEVEL flow: debug(local) / warning(staging) / error(production)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
# development: sqlite (also used by the automated test suite)
# staging/production: pgsql
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=quizbuilder
# DB_USERNAME=quizbuilder
# DB_PASSWORD=

# --- Frontend / CORS ---------------------------------------------------------
# Comma-separated origins the API accepts cross-origin requests from.
# Must exactly match the browser origin(s) (scheme + host + port).
# development: http://localhost:3000
# production:  https://app.yourdomain.com,https://admin.yourdomain.com
FRONTEND_URLS=http://localhost:3000

# --- Authentication (Sanctum personal access tokens) ------------------------
# Token lifetime in minutes. Default 30 days (43200).
SANCTUM_TOKEN_TTL_MINUTES=43200

# --- Sessions / State --------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (used only for password reset flows, none ship yet) ----------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (unused; media stay on the local `public` disk) -----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Backup & ops (consumed by ops/ scripts, see DEPLOYMENT.md) ---------------
# BACKUP_DIR=/srv/backups/quizbuilder
# BACKUP_RETENTION_DAYS=14
# MEDIA_DIR=storage/app/public/media